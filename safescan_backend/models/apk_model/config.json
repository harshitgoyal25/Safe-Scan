    "reg_alpha": 0.1,
    "reg_lambda": 0.1,
    "class_weight": "balanced",
    "random_state": 42
  },
  "threshold": {
    "selection_data": "validation_only",
    "criterion": "best_precision_with_recall_at_least_95_percent",
    "value": 0.5199999999999998
  },
  "split": {
    "strategy": "stratified",
    "train_fraction": 0.7,
    "validation_fraction": 0.15,
    "test_fraction": 0.15,
