    "max_features": 100000
  },
  "combined_features": 200000,
  "model": {
    "algorithm": "LogisticRegression",
    "C": 2.0,
    "class_weight": "balanced",
    "solver": "liblinear",
    "max_iter": 2000,
    "random_state": 42
  },
  "threshold": {
    "value": 0.41,
    "selection_data": "validation",
    "criterion": "best_f1"
