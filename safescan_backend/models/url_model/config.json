{
  "project": "SafeScan",
  "model_type": "LogisticRegression",
  "dataset": "URL dataset.csv",
  "task": "Binary URL classification",
  "seed": 42,
  "dataset_info": {
    "samples": 450176,
    "legitimate": 345738,
    "phishing": 104438
  },
  "split": {
    "strategy": "stratified",
    "train_fraction": 0.7,
    "validation_fraction": 0.15,
    "test_fraction": 0.15,
    "random_state": 42
  },
  "label_mapping": {
    "legitimate": 0,
    "phishing": 1
  },
  "word_tfidf": {
